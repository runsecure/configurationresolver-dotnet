<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The version of the next release. 0.x marks the API as pre-release: it may still change.
       CI and release builds override it with -p:Version; a release tag's version must match it
       (see scripts/ConfigurationResolverPackaging.ps1). -->
  <PropertyGroup>
    <VersionPrefix>0.9.0</VersionPrefix>
  </PropertyGroup>

  <!-- Every package is licensed under the Mozilla Public License 2.0 (see LICENSE). -->
  <PropertyGroup>
    <Authors>Torin Blair</Authors>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/runsecure/configurationresolver-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/runsecure/configurationresolver-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Supply chain. Every project records its full resolved dependency graph, content hashes
       included, in packages.lock.json; on a CI build restore must match it exactly, so a changed
       or substituted package fails the build instead of being picked up. nuget.config restricts
       every package to nuget.org. Update the lock files deliberately, by running dotnet restore
       with its force-evaluate option after changing a version. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!-- The shipped libraries build warning-free and stay that way, and each packs a symbols
       package (.snupkg) beside its .nupkg. Releases Authenticode-sign each assembly before
       packing; see scripts/ConfigurationResolverPackaging.ps1. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Every *Tests project shares these: not packable, and xUnit's own API available without a
       per-file using directive. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
